# ==============================================================================
# NOLAN by WYLEN | Sistema de Control de Asistencia
# Archivo de plantilla de variables de entorno (.env.example)
# ==============================================================================
#
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a '.env.local' en la raíz del proyecto.
# 2. Rellena los valores reales obtenidos desde tu proyecto en Supabase:
#    Panel de Supabase -> Project Settings -> API
# 3. NUNCA subas '.env.local' a Git ni compartas la clave 'service_role'.
#

# ------------------------------------------------------------------------------
# SUPABASE - Conexión Pública (Navegador y Servidor bajo políticas RLS)
# ------------------------------------------------------------------------------
# URL del proyecto en Supabase (ejemplo: https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública / Publishable Key (o Anon Key) de Supabase
# Esta clave es pública y está sujeta estrictamente a las políticas de Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key-o-anon-key-aqui

# ------------------------------------------------------------------------------
# SUPABASE - Conexión Privilegiada (EXCLUSIVO DEL SERVIDOR)
# ------------------------------------------------------------------------------
# Clave con rol de servicio (Service Role Key). Permite omitir RLS.
# ¡REGLAS DE SEGURIDAD CRÍTICAS!:
# - NUNCA uses esta clave en componentes marcados con 'use client'.
# - NUNCA agregues el prefijo 'NEXT_PUBLIC_' a esta clave.
# - Se usa exclusivamente en Server Actions administrativas o en la recepción de tramas del checador.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta-aqui

# ------------------------------------------------------------------------------
# HARDWARE / CHECADOR BIOMÉTRICO (ZKTeco MB10V)
# ------------------------------------------------------------------------------
# Token secreto precompartido para autenticar las tramas HTTP del checador o gateway
CHECADOR_DEVICE_TOKEN=tu-token-de-dispositivo-aleatorio-y-seguro

# ------------------------------------------------------------------------------
# PEXELS API (Fondos dinámicos en video)
# ------------------------------------------------------------------------------
PEXELS_API_KEY=tu-api-key-de-pexels

